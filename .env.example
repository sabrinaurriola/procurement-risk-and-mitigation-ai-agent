# Copy to .env (never commit .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres   # Supabase Session pooler URI
OPENAI_API_KEY=
OPENAI_MODEL=            # set after the model check is approved
TAVILY_API_KEY=
OPERATING_MARKET=ES
# Day 4 (names only; set real values only in .env)
ASSESSMENT_API_KEY=                 # required by the FastAPI service (S1); the app refuses to start without it
ASSESSMENT_STORE_DIR=               # optional override of runs/assessments
ASSESSMENT_DEADLINE_SECONDS=        # optional HTTP wait before 504 "still running" (default 150)
# OPS_DATABASE_URL=                 # RESERVED for S2 (INSERT-only ops_writer role). Not read by any code yet; do not create until gate G-OPS passes
# Day 4 Gradio -> n8n bridge (names only; real values only in .env). HTTPS URLs only; the secret goes in the X-Webhook-Secret header
N8N_ARCHIVE_WEBHOOK_URL=            # production webhook URL of the n8n archive workflow (https://...)
N8N_EMAIL_WEBHOOK_URL=              # production webhook URL of the n8n e-mail workflow (https://...)
N8N_WEBHOOK_SECRET=                 # shared secret = value of the n8n Header Auth credential
# ALLOW_PAID_CALLS=1                # set per process only for an approved live run
PDF_FONT_DIR=                       # optional: directory with the pinned DejaVu fonts (default assets/fonts; fetch with python -m src.bridge.fonts --fetch)
# LIVE_BUDGET_USD=                 # optional: a LOWER paid-call budget than the USD 5 hard limit (it can never raise it)
# OPENAI_REASONING_EFFORT=low       # optional; earlier live runs used low
