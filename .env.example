# Copy to .env (never commit .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres   # Supabase Session pooler URI
OPENAI_API_KEY=
OPENAI_MODEL=            # set after the model check is approved
TAVILY_API_KEY=
OPERATING_MARKET=ES
# Day 4 (names only; set real values only in .env)
ASSESSMENT_API_KEY=                 # required by the FastAPI service (S1); the app refuses to start without it
ASSESSMENT_STORE_DIR=               # optional override of runs/assessments
ASSESSMENT_DEADLINE_SECONDS=        # optional HTTP wait before 504 "still running" (default 150)
